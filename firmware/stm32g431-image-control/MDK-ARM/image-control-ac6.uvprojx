            <File><FileName>stm32g4xx_hal_rcc.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_rcc.c</FilePath></File>
            <File><FileName>stm32g4xx_hal_rcc_ex.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_rcc_ex.c</FilePath></File>
            <File><FileName>stm32g4xx_hal_uart.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_uart.c</FilePath></File>
            <File><FileName>stm32g4xx_hal_uart_ex.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_uart_ex.c</FilePath></File>
