<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">

  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>

  <Targets>
    <Target>
      <TargetName>STM32G431RBTx</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6070000::V6.7::.\ARMCLANG</pCCUsed>
      <uAC6>1</uAC6>
      <TargetOption>
        <TargetCommonOption>
          <Device>STM32G431RBTx</Device>
          <Vendor>STMicroelectronics</Vendor>
          <PackID>Keil.STM32G4xx_DFP.1.2.0</PackID>
          <PackURL>http://www.keil.com/pack/</PackURL>
          <Cpu>IROM(0x08000000-0x801FFFF) IRAM(0x20000000-0x20007FFF) IRAM(0x10000000-0x100027FF) CLOCK(8000000) FPU2 CPUTYPE("Cortex-M4")</Cpu>
          <SFDFile>$$Device:STM32G431RBTx$CMSIS\SVD\STM32G4_v0r8.svd</SFDFile>
          <OutputDirectory>Output\</OutputDirectory>
          <OutputName>image-control</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>1</BrowseInformation>
          <ListingPath>Listing\</ListingPath>
        </TargetCommonOption>
        <CommonProperty>
          <UseCPPCompiler>0</UseCPPCompiler>
          <IncludeInBuild>1</IncludeInBuild>
        </CommonProperty>
        <Utilities>
          <Flash1>
            <UseTargetDll>1</UseTargetDll>
            <UseExternalTool>0</UseExternalTool>
            <RunIndependent>0</RunIndependent>
            <UpdateFlashBeforeDebugging>1</UpdateFlashBeforeDebugging>
            <Capability>1</Capability>
            <DriverSelection>4107</DriverSelection>
          </Flash1>
          <bUseTDR>1</bUseTDR>
          <Flash2>STLink\ST-LINKIII-KEIL_SWO.dll</Flash2>
        </Utilities>
        <TargetArmAds>
          <ArmAdsMisc>
            <AdsCpuType>"Cortex-M4"</AdsCpuType>
            <RvdsVP>2</RvdsVP>
            <OnChipMemories>
              <IRAM><Type>0</Type><StartAddress>0x20000000</StartAddress><Size>0x8000</Size></IRAM>
              <IROM><Type>1</Type><StartAddress>0x8000000</StartAddress><Size>0x20000</Size></IROM>
              <OCR_RVCT9><Type>0</Type><StartAddress>0x10000000</StartAddress><Size>0x2800</Size></OCR_RVCT9>
            </OnChipMemories>
          </ArmAdsMisc>
          <Cads>
            <interw>1</interw>
            <Optim>7</Optim>
            <wLevel>3</wLevel>
            <uC99>1</uC99>
            <v6Lang>3</v6Lang>
            <v6LangP>3</v6LangP>
            <VariousControls>
              <MiscControls></MiscControls>
              <Define>STM32G431xx,USE_HAL_DRIVER</Define>
              <Undefine></Undefine>
              <IncludePath>..\\Core\\Inc;..\\App\\Inc;..\\BSP\\Inc;..\\Drivers\\CMSIS\\Include;..\\Drivers\\CMSIS\\Device\\ST\\STM32G4xx\\Include;..\\Drivers\\STM32G4xx_HAL_Driver\\Inc;..\\Drivers\\STM32G4xx_HAL_Driver\\Inc\\Legacy</IncludePath>
            </VariousControls>
          </Cads>
          <Aads>
            <interw>1</interw>
          </Aads>
          <LDads>
            <umfTarg>1</umfTarg>
            <TextAddressRange>0x08000000</TextAddressRange>
            <DataAddressRange>0x20000000</DataAddressRange>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File><FileName>app_main.c</FileName><FileType>1</FileType><FilePath>..\\App\\Src\\app_main.c</FilePath></File>
            <File><FileName>app_processing.c</FileName><FileType>1</FileType><FilePath>..\\App\\Src\\app_processing.c</FilePath></File>
            <File><FileName>app_pipeline.c</FileName><FileType>1</FileType><FilePath>..\\App\\Src\\app_pipeline.c</FilePath></File>
