            <File><FileName>stm32g4xx_hal_flash.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_flash.c</FilePath></File>
            <File><FileName>stm32g4xx_hal_flash_ex.c</FileName><FileType>1</FileType><FilePath>..\\Drivers\\STM32G4xx_HAL_Driver\\Src\\stm32g4xx_hal_flash_ex.c</FilePath></File>
